rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.active == true;
    }
    function validText(value, maximum) {
      return value is string && value.size() > 0 && value.size() <= maximum
        && value.matches('[\\s\\S]*[^\\s][\\s\\S]*');
    }
    function validCoordinates(point) {
      return point is map
        && point.keys().hasAll(['latitude', 'longitude', 'source', 'accuracyMeters'])
        && point.keys().hasOnly(['latitude', 'longitude', 'source', 'accuracyMeters'])
        && point.latitude is number && point.latitude >= -90 && point.latitude <= 90
        && point.longitude is number && point.longitude >= -180 && point.longitude <= 180
        && ((point.source == 'manual' && point.accuracyMeters == null)
          || (point.source == 'device' && point.accuracyMeters is number
            && point.accuracyMeters >= 0 && point.accuracyMeters <= 20000000));
    }
    function validAdvisory(data) {
      return data.keys().hasAll(['category', 'title', 'summary', 'isPublished', 'publishedAt', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['category', 'title', 'summary', 'isPublished', 'publishedAt', 'createdAt', 'updatedAt'])
        && data.category in ['Flood', 'Weather', 'Community']
        && validText(data.title, 140)
        && validText(data.summary, 1500)
        && data.isPublished is bool;
    }
    match /staff/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /floodReports/{reportId} {
      allow get, list: if signedIn() && (resource.data.residentId == request.auth.uid || isStaff());
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['residentId', 'barangay', 'locationDetails', 'severity', 'description', 'photoName', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['residentId', 'barangay', 'locationDetails', 'severity', 'description', 'photoName', 'status', 'createdAt', 'updatedAt', 'coordinates'])
        && (!('coordinates' in request.resource.data) || validCoordinates(request.resource.data.coordinates))
        && request.resource.data.residentId == request.auth.uid
        && validText(request.resource.data.barangay, 100)
        && validText(request.resource.data.locationDetails, 300)
        && validText(request.resource.data.description, 3000)
        && request.resource.data.severity in ['Low', 'Medium', 'High']
        && request.resource.data.photoName is string
        && request.resource.data.photoName.size() <= 255
        && request.resource.data.status == 'Submitted'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['Submitted', 'Under Review', 'Verified', 'Resolved', 'Closed']
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /advisories/{advisoryId} {
      allow get, list: if isStaff() || resource.data.isPublished == true;
      allow create: if isStaff()
        && validAdvisory(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && ((request.resource.data.isPublished == true && request.resource.data.publishedAt == request.time)
          || (request.resource.data.isPublished == false && request.resource.data.publishedAt == null));
      allow update: if isStaff()
        && validAdvisory(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && ((request.resource.data.isPublished == true && request.resource.data.publishedAt == request.time)
          || (request.resource.data.isPublished == false && request.resource.data.publishedAt == null));
      allow delete: if isStaff();
    }
  }
}
