{
  "name": "bantaybaha-cainta",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "dev:emulator": "vite --mode emulator --host localhost --port 5174 --strictPort",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-bantaybaha",
    "test:rules": "firebase emulators:exec --only auth,firestore --project demo-bantaybaha \"node --test tests/firestore.test.mjs\"",
    "test:content": "node --test tests/preparedness.test.mjs",
    "seed:demo": "node scripts/seed-demo.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.30.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
